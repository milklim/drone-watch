# Copy to `.env` for local development.

# Mapbox GL access token (public `pk.` token). Required for the Mapbox engine;
# the Leaflet engine works without it. Get one free at https://account.mapbox.com
VITE_MAPBOX_TOKEN=

# Backend endpoints. Locally these are same-origin paths proxied to :8080 by
# Vite (see vite.config.ts), so the browser only ever talks to the Vite origin.
# In production set absolute URLs, e.g.
#   VITE_WS_URL=wss://your-backend.onrender.com/ws
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_WS_URL=/ws
VITE_API_URL=/api
